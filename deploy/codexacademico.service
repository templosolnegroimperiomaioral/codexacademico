[Unit]
Description=Codex Acadêmico
After=network.target

[Service]
Type=simple
User=codex
Group=codex
WorkingDirectory=/opt/codexacademico
EnvironmentFile=/opt/codexacademico/.env
ExecStart=/usr/bin/node /opt/codexacademico/dist/index.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/codexacademico/uploads

[Install]
WantedBy=multi-user.target
