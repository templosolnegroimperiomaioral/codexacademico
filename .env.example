# Ambiente
NODE_ENV=production
PORT=3000
APP_BASE_URL=https://SEU-DOMINIO

# Banco MySQL
DATABASE_URL=mysql://codex_user:Erikamor@127.0.0.1:3306/codex_academico

# Necessário somente para docker-compose.yml.
MYSQL_PASSWORD=erikamor-mysql
MYSQL_ROOT_PASSWORD=erikamor-mysql

# Segurança: gere valores longos e aleatórios, nunca reutilize senhas.
JWT_SECRET=e-r-i-k-a-m-o-r-d-a-m-i-n-h-a-v-i-d-a
CRON_SECRET=e-r-i-k-a-m-o-r-d-a-m-i-n-h-a-v-i-d-a

# OAuth Google. Cadastre os dois callbacks indicados no guia de publicação.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CLOUD_PROJECT_ID=seu-projeto-google

# Arquivos enviados pelos estudantes. Inclua este diretório na rotina de backup.
UPLOAD_DIR=/opt/codexacademico/uploads
